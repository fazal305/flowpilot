# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Frontend origin allowed to call this API (CORS)
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (Supabase project -> Settings -> Database)
DATABASE_URL=postgresql://user:password@host:5432/flowpilot

# Random 32+ char secret used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string

# OpenRouter API key — server-side only, never sent to the frontend.
# This is an educational/portfolio project: bring your own key from
# https://openrouter.ai. Without one, the AI node and AI workflow
# generation both run with clearly-labeled mocked responses instead.
OPENROUTER_API_KEY=
